<script is:inline>
  (function () {
    var btn = document.getElementById('tally-inquiry-btn');
    if (!btn) return;

    btn.addEventListener('click', function () {
      if (typeof Tally === 'undefined') {
        window.open('https://tally.so/r/vGOkvg', '_blank');
        return;
      }

      Tally.openPopup('vGOkvg', {
        layout: 'default',
        width: 480,
        overlay: true,
        onSubmit: function () {
          window.location.href = '/thank-you';
        }
      });
    });
  })();
</script>
